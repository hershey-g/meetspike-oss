// Template. The ids below are placeholders on purpose.
// `npm run setup` creates the resources and writes the real ids into
// wrangler.production.jsonc, which git ignores. Do not put real ids here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meetspike",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,

  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/hooks/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meetspike-db",
      "database_id": "REPLACE_D1_DATABASE_ID"
    }
  ],

  "r2_buckets": [
    { "binding": "RAW", "bucket_name": "meetspike-raw" }
  ],

  "kv_namespaces": [
    { "binding": "TOKENS", "id": "REPLACE_KV_NAMESPACE_ID" }
  ],

  "queues": {
    "producers": [{ "binding": "INGEST_Q", "queue": "meetspike-ingest" }],
    "consumers": [
      {
        "queue": "meetspike-ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "meetspike-ingest-dlq"
      }
    ]
  },

  "workflows": [
    {
      "name": "meetspike-backfill",
      "binding": "BACKFILL",
      "class_name": "OuraBackfillWorkflow"
    },
    {
      "name": "meetspike-reconcile",
      "binding": "RECONCILE",
      "class_name": "NightlyReconcileWorkflow",
      "schedules": ["0 11 * * *"]
    }
  ],

  "observability": { "enabled": true },

  // WEARABLE picks the data source: "whoop" or "oura".
  // It is deliberately not set in this template. When it is not set, an
  // install that already has Oura keys keeps using Oura, and anything else
  // uses WHOOP. `npm run setup` writes it for a new install; you can also set
  // it as a secret (`wrangler secret put WEARABLE`) or in .dev.vars locally.
  "vars": {
    "OURA_SANDBOX": "true"
  }
}
